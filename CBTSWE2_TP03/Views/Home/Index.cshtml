@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @if (!Model.Any())
    {
        <div class="min-vh-100 d-flex align-items-center justify-content-center">
            <div class="text-center w-100" style="max-width:560px;">
                
                <div class="card-body py-5">
                    <h1 class="display-6 fw-bold mb-3">Sem produtos cadastrados</h1>
                    <div>
                        <a asp-controller="Produto" asp-action="Cadastrar" class="btn btn-outline-primary">Cadastrar novo produto</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <h2>Produtos</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Preço</th>
                    <th>Qtd Estoque</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nome</td>
                        <td>@p.Descricao</td>
                        <td>@p.Preco.ToString("C")</td>
                        <td>@p.QtdEstoque</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
